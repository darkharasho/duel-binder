update as expected (https://react.dev/reference/react/useRef).\n\n/var/tmp/rip-wt/src/renderer/src/features/browse/BrowsePage.tsx:198:5\n  196 |     // listNav only calls this on a step, never during render.\n  197 |     // eslint-disable-next-line react-hooks/refs\n> 198 |     (c) => void open(c),\n      |     ^^^^^^^^^^^^^^^^^^^ Passing a ref to a function may read its value during render\n  199 |     (c) => c.id\n  200 |   )\n  201 |",["17371"],["17372"],"React Hook useEffect has missing dependencies: 'setId', 'setIndex', and 'split'. Either include them or remove the dependency array.",["17373"],["17374"],["17375"],["17376"],"React Hook useEffect has a missing dependency: 'hub'. Either include it or remove the dependency array.",["17377"],["17378"],["17379"],["17380"],["17381"],["17382"],["17383"],["17384"],["17385"],["17386"],["17387"],"Replace `⏎····CHECKLIST_SORTS.filter((s)·=>·!HIDDEN_SORTS[game].includes(s.value))⏎··` with `CHECKLIST_SORTS.filter((s)·=>·!HIDDEN_SORTS[game].includes(s.value))`",{"range":"17388","text":"17389"},"Replace `⏎··tiles:·readonly·PrefetchTile[],⏎··size:·'small'·|·'full'⏎` with `tiles:·readonly·PrefetchTile[],·size:·'small'·|·'full'`",{"range":"17390","text":"17391"},"Replace `·month:·'short',·year:·'numeric',·timeZone:·'UTC'·` with `⏎··month:·'short',⏎··year:·'numeric',⏎··timeZone:·'UTC'⏎`",{"range":"17392","text":"17393"},["17394"],["17395"],["17396"],["17397"],["17398"],["17399"],"Fast refresh only works when a file has exports. Move your component(s) to a separate file.","noExport",["17400"],"Replace `'name',·'cardType',·'frameType',·'race',·'attribute',·'level',·'archetype',·'set',·'rarity'` with `⏎····'name',⏎····'cardType',⏎····'frameType',⏎····'race',⏎····'attribute',⏎····'level',⏎····'archetype',⏎····'set',⏎····'rarity'⏎··`",{"range":"17401","text":"17402"},{"range":"17403","text":"16506"},{"range":"17404","text":"16193"},{"range":"17405","text":"16193"},{"range":"17406","text":"16193"},{"range":"17407","text":"16193"},"Repl
{
  "name": "duel-binder",
  "version": "0.10.1",
  "description": "Duel Binder: a local Yu-Gi-Oh! card collection binder",
  "main": "./out/main/index.js",
  "author": "darkharasho",
  "homepage": "https://github.com/darkharasho/duel-binder",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:phone": "tsc --noEmit -p tsconfig.phone.json --composite false",
    "build:web": "vite build --config vite.web.config.ts",
    "build:phone": "cross-env NODE_ENV=production vite build --config vite.phone.config.ts",
    "dev:phone": "vite --config vite.phone.config.ts",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:phone",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "site:shots": "bash scripts/site/shots.sh",
    "dev:fake-data": "cross-env YGO_FAKE_DATA=1 electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "catalog:job": "vite build --config scripts/catalog/vite.config.ts && cross-env ELECTRON_RUN_AS_NODE=1 electron out/catalog/build.mjs",
    "catalog:parity": "vite build --config scripts/catalog/vite.config.ts && cross-env ELECTRON_RUN_AS_NODE=1 electron out/catalog/parity.mjs",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run --maxWorkers=2"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^9.3.1",
    "@techstark/opencv-js": "4.12.0-release.1",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/jpn": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jpeg-js": "^0.4.4",
    "jsdom": "^29.1.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
